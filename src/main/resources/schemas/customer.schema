# Customer master data - typical CRM / signup test fixture.
# Fields are generated top-to-bottom; email/fullName reuse firstName/lastName.
customerId:  sequence(100000)
externalId:  uuid                              | unique
firstName:   firstName
lastName:    lastName
fullName:    fullName
email:       email                             | unique
phone:       phone                             | null=0.1
dateOfBirth: date(1950-01-01, 2006-12-31)
street:      street
city:        city
state:       state
zip:         zip
country:     constant(United States)
company:     company                           | null=0.3
tier:        oneOf(BRONZE:60, SILVER:25, GOLD:12, PLATINUM:3)
active:      boolean(0.9)
createdAt:   datetime(2022-01-01, 2026-06-30)
